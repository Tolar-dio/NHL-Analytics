k.","u":"https://bsky.app/profile/charlieoconn.bsky.social/post/3n2pl2zlasc2t"},{"a":"Charlie O'Connor","d":"2026-11-20T02:37:14+00:00","h":"charlieoconn.bsky.social","o":"PHLY Sports","t":"Konecny tried to draw a penalty on the entry, and but it looks like he's getting whistled for a dive as well. Konecny was mystified by the call, he stayed on the ice along the boards for a while, even as an old guy Ottawa fan behind the glass taunted him.","u":"https://bsky.app/profile/charlieoconn.bsky.social/post/3n2pkjnjckc2t"},{"a":"Charlie O'Connor","d":"2026-11-20T02:14:53+00:00","h":"charlieoconn.bsky.social","o":"PHLY Sports","t":"Wait a second. Konecny finds Foerster on a quick-strike 2-on-1, and it's 5-4. Maybe this game isn't over.","u":"https://bsky.app/profile/charlieoconn.bsky.social/post/3n2pjboxjdk2t"}],"team":"PHI","threads":[{"d":"2026-11-10T03:42:45+00:00","sub":"hockey","t":"Philadelphia [2]-0 Vancouver; Travis Konecny","u":"https://www.reddit.com/r/hockey/comments/1xscr9e/philadelphia_20_vancouver_travis_konecny/"}],"videos":[{"d":"2026-11-20T05:42:34+00:00","id":"YGOFObOEz6o","k":"presser","t":"11/19 PHI at OTT Postgame: Travis Konecny","team":"PHI","u":"https://www.youtube.com/watch?v=YGOFObOEz6o"}]}